generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum PaymentType {
  MONTHLY
  CLASS
}

enum PaymentMethod {
  CASH
  ONLINE
}

enum PaymentStatus {
  PAID
  PENDING
}

enum ClassType {
  ONLINE
  OFFLINE
}

enum ScheduleDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ClassStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EnrollmentRequestStatus {
  REQUESTED
  PAYMENT_SUBMITTED
  APPROVED
  REJECTED
}

enum HomeworkSubmissionStatus {
  PENDING
  SUBMITTED
  REVIEWED
}

enum MaterialCategory {
  WORKSHEET
  STORY
  VIDEO
}

model User {
  id                     String          @id @default(cuid())
  name                   String
  email                  String?         @unique
  phone                  String?         @unique
  passwordHash           String
  role                   UserRole        @default(STUDENT)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  student                Student?
  assignedClasses        Class[]         @relation("AssignedTeacherClasses")
  createdClasses         Class[]         @relation("CreatedClassRecords")
  createdQuizzes         Quiz[]          @relation("TeacherQuizzes")
  createdProgressEntries ProgressEntry[] @relation("TeacherProgressEntries")
  createdHomework        Homework[]      @relation("TeacherHomework")
  createdMaterials       Material[]      @relation("TeacherMaterials")
  createdAnnouncements   Announcement[]  @relation("TeacherAnnouncements")
}

model Student {
  id              String               @id @default(cuid())
  name            String
  phone           String               @unique
  parentName      String
  parentContact   String?
  grade           String?
  school          String?
  learningLevel   String?
  notes           String?              @db.Text
  qrCode          String               @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  userId          String               @unique
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances     Attendance[]
  payments        Payment[]
  enrollments     ClassEnrollment[]
  results         Result[]
  progressEntries ProgressEntry[]
  homeworkEntries HomeworkSubmission[]

  @@index([name])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  date      DateTime         @db.Date
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([date])
}

model Payment {
  id                  String                 @id @default(cuid())
  studentId           String
  enrollmentRequestId String?                @unique
  amount              Decimal                @db.Decimal(10, 2)
  type                PaymentType
  method              PaymentMethod
  status              PaymentStatus
  date                DateTime               @db.Date
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  student             Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollmentRequest   ClassEnrollmentRequest? @relation("EnrollmentRequestPayment", fields: [enrollmentRequestId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([status])
}

model Class {
  id                 String                   @id @default(cuid())
  title              String
  subject            String
  level              String
  type               ClassType
  status             ClassStatus              @default(ACTIVE)
  date               DateTime                 @db.Date
  scheduleDay        ScheduleDay
  time               String
  endTime            String
  link               String?
  location           String?
  capacity           Int                      @default(20)
  fee                Decimal                  @default(0) @db.Decimal(10, 2)
  notes              String?                  @db.Text
  teacherId          String
  createdById        String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  teacher            User                     @relation("AssignedTeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  createdBy          User                     @relation("CreatedClassRecords", fields: [createdById], references: [id], onDelete: Cascade)
  enrollments        ClassEnrollment[]
  enrollmentRequests ClassEnrollmentRequest[]
  homework           Homework[]

  @@index([date])
  @@index([scheduleDay, time])
  @@index([status])
  @@index([teacherId])
}

model ClassEnrollment {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
}

model ClassEnrollmentRequest {
  id                String                  @id @default(cuid())
  classId           String
  studentName       String
  studentPhone      String
  studentEmail      String?
  parentName        String
  parentContact     String?
  grade             String?
  school            String?
  learningLevel     String?
  notes             String?                 @db.Text
  status            EnrollmentRequestStatus @default(REQUESTED)
  paymentSlipName   String?
  paymentSlipUrl    String?
  reviewNote        String?                 @db.Text
  approvedStudentId String?
  reviewedAt        DateTime?
  approvedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  class             Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  payment           Payment?                @relation("EnrollmentRequestPayment")

  @@index([classId, status])
  @@index([studentPhone])
  @@index([createdAt])
}

model Homework {
  id             String               @id @default(cuid())
  title          String
  description    String?              @db.Text
  deadline       DateTime             @db.Date
  attachmentName String?
  attachmentUrl  String?
  classId        String
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  class          Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy      User                 @relation("TeacherHomework", fields: [createdById], references: [id], onDelete: Cascade)
  submissions    HomeworkSubmission[]

  @@index([classId, deadline])
}

model HomeworkSubmission {
  id           String                   @id @default(cuid())
  homeworkId   String
  studentId    String
  status       HomeworkSubmissionStatus @default(PENDING)
  responseName String?
  responseUrl  String?
  score        Int?
  maxScore     Int?
  feedback     String?                  @db.Text
  submittedAt  DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  homework     Homework                 @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student      Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([studentId, status])
}

model ProgressEntry {
  id          String   @id @default(cuid())
  studentId   String
  month       DateTime @db.Date
  listening   Int
  reading     Int
  writing     Int
  speaking    Int
  comment     String?  @db.Text
  testMark    Int?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("TeacherProgressEntries", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([studentId, month])
  @@index([month])
}

model Material {
  id          String           @id @default(cuid())
  title       String
  category    MaterialCategory
  description String?          @db.Text
  fileName    String
  fileUrl     String
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User             @relation("TeacherMaterials", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([category])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  message     String   @db.Text
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("TeacherAnnouncements", fields: [createdById], references: [id], onDelete: Cascade)
}

model Quiz {
  id          String     @id @default(cuid())
  title       String
  description String?
  createdById String
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   User       @relation("TeacherQuizzes", fields: [createdById], references: [id], onDelete: Cascade)
  questions   Question[]
  results     Result[]
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  prompt        String
  options       Json
  correctAnswer Int
  createdAt     DateTime @default(now())
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model Result {
  id             String   @id @default(cuid())
  quizId         String
  studentId      String
  answers        Json
  score          Int
  totalQuestions Int
  submittedAt    DateTime @default(now())
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@index([submittedAt])
}
